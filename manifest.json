{
  "manifest_version": 3,
  "name": "GitLab MR Approval Guard",
  "version": "1.0",
  "description": "Prevents merging MRs without approvals and shows warnings for critical branches.",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["https://gitlab.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "gitlab-mr-approval-guard@codewithemad.ir",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
